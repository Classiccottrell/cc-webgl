{
  "name": "cc-webgl",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/adapters/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./matter": {
      "types": "./dist/matter/index.d.ts",
      "import": "./dist/matter/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:example": "tsc -p example/tsconfig.json --noEmit",
    "dev": "vite --config example/vite.config.ts"
  },
  "peerDependencies": {
    "three": "^0.185.1",
    "react": ">=18",
    "gsap": ">=3",
    "lenis": ">=1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "lenis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "@types/react": "^18.3.0",
    "gsap": "^3.12.0",
    "happy-dom": "^15.11.0",
    "react": "^18.3.0",
    "three": "^0.185.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
